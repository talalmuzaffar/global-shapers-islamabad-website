{
  "name": "global-shapers-faisalabad-website",
  "version": "1.0.0",
  "description": "Global Shapers Faisalabad Hub Website",
  "scripts": {
    "seed": "node scripts/generate-seed.js",
    "db:init:local": "wrangler d1 execute global-shapers-db --local --file=schema.sql && wrangler d1 execute global-shapers-db --local --file=seed.sql",
    "db:init:remote": "wrangler d1 execute global-shapers-db --remote --file=schema.sql && wrangler d1 execute global-shapers-db --remote --file=seed.sql",
    "dev": "wrangler pages dev .",
    "build": "echo 'Static site - no build needed'",
    "deploy": "wrangler pages deploy ."
  },
  "keywords": [
    "global-shapers",
    "faisalabad",
    "website"
  ],
  "author": "Global Shapers Faisalabad Hub",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.92.0"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talalmuzaffar/global-shapers-islamabad-website.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/talalmuzaffar/global-shapers-islamabad-website/issues"
  },
  "homepage": "https://github.com/talalmuzaffar/global-shapers-islamabad-website#readme"
}
